# Thong tin ket noi API chinh thuc AMIS CRM.
# Sao chep file nay thanh .env, sau do thay hai gia tri ben duoi.
AMIS_CLIENT_ID=DIEN_APP_ID_CUA_BAN
AMIS_CLIENT_SECRET=DIEN_MA_BAO_MAT_CUA_BAN

# Ma kho can doc ton. Vi du: HCM 3
AMIS_STOCK_CODE=HCM 3

# Chuoi ket noi database dich khi chay dong bo that.
DATABASE_URL=DIEN_DATABASE_URL_CUA_BAN

# Tuy chon. De trong se dung https://crmconnect.misa.vn/api/v2
# AMIS_API_BASE=https://crmconnect.misa.vn/api/v2

# Luu y: ba bien duoi day chi dung cho API NOI BO lay ton theo lo.
# AppID va ma bao mat khong thay the duoc AMIS_APP_TOKEN.
# AMIS_APP_TOKEN=
# AMIS_APP_REFRESH_TOKEN=
# AMIS_COMPANY_CODE=
# AMIS_BATCH_STOCK_ID=
